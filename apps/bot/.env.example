# Discord bot token
DISCORD_BOT_TOKEN=

# MariaDB (DiscordSRV whitelist database)
DISCORD_DATABASE_URL=

# PostgreSQL (application database)
DATABASE_URL=postgresql://crabcraft:crabcraft_dev@localhost:5432/crabcraft

# CrabCraft API base URL (optional; defaults to production)
CRABCRAFT_API_URL=https://api.crabcraft.net

# Stream monitor API credentials (optional)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenAI key for counting-channel image/GIF number recognition (optional)
OPENAI_API_KEY=

# Discord Gallery media storage (Backblaze B2 via its S3-compatible API)
# Replace the endpoint and region with the values reported for your B2 bucket.
GALLERY_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
GALLERY_S3_ACCESS_KEY_ID=
GALLERY_S3_SECRET_ACCESS_KEY=
GALLERY_S3_BUCKET=
GALLERY_S3_REGION=eu-central-003
GALLERY_MEDIA_BASE_URL=https://cdn.crabcraft.net

# Cloudflare single-file cache purge (required with Gallery S3 storage)
GALLERY_CLOUDFLARE_ZONE_ID=
GALLERY_CLOUDFLARE_CACHE_PURGE_TOKEN=

# PostHog product analytics (optional; both token and salt are required)
# Use the same long random salt in the web, bot and Velocity configurations.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSON_SALT=
POSTHOG_ENVIRONMENT=production

# Copy apps/bot/config.example.json to apps/bot/config.json, then add the
# Discord role/channel IDs for your server.
