# Bot environment: "development" or "production"
ENV=development

# Discord bot token
TOKEN=

# Discord server ID (used for local slash command deployment in development)
DEV_GUILD_ID=

# Role IDs
MEMBER_ROLE_ID=
MOD_ROLE_ID=

# Channel / category IDs
APPLICATION_CATEGORY_ID=
LOG_CHANNEL_ID=
LEADERBOARD_CHANNEL_ID=

# MariaDB (DiscordSRV whitelist database)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Wiki recent changes (optional)
WIKI_CHANNEL_ID=

# PostgreSQL (application database)
DATABASE_URL=postgresql://crabcraft:crabcraft_dev@localhost:5432/crabcraft
