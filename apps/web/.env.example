AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret
AUTH_SECRET=a-random-secret-string
GALLERY_MEDIA_BASE_URL=https://cdn.crabcraft.net
CHAT_STREAM_URL=https://api.crabcraft.net/chat/events
MINECRAFT_API_BASE_URL=https://api.crabcraft.net
DATABASE_URL=postgresql://crabcraft:crabcraft_dev@localhost:5432/crabcraft

# Public AdSense identifiers (not API secrets). Runtime configuration; no NEXT_PUBLIC prefix needed.
# Configure Google's consent messages before enabling. The ad unit is reused for all eight placements.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
