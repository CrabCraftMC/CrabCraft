AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret
AUTH_SECRET=a-random-secret-string
GALLERY_MEDIA_BASE_URL=https://cdn.crabcraft.net
CHAT_STREAM_URL=https://api.crabcraft.net/chat/events
DATABASE_URL=postgresql://crabcraft:crabcraft_dev@localhost:5432/crabcraft

# Privacy-preserving product analytics. Use the same person salt in the bot,
# website, and Velocity proxy. Leave the token blank to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=production
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
POSTHOG_PERSON_SALT=

# Optional production secret injection. When all four required values are set,
# the container fetches runtime secrets such as POSTHOG_PERSON_SALT from
# Infisical before starting Next.js.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=
# INFISICAL_DOMAIN=
