{
  "name": "crabcraft",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "bun run --filter @crabcraft/db studio",
    "seed:awards": "bun run --cwd packages/db scripts/seed-awards.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "postgres": "^3.4.9",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "axios": "1.16.0",
    "esbuild": "0.25.12",
    "form-data": "4.0.6",
    "postcss": "8.5.10",
    "undici": "6.27.0",
    "ws": "8.21.0"
  },
  "packageManager": "bun@1.3.13"
}
