{
  "name": "crabcraft",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "bun run --filter @crabcraft/db studio",
    "seed:awards": "bun run --cwd packages/db scripts/seed-awards.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.2",
    "postgres": "^3.4.9",
    "tiktok-live-connector": "^2.1.1-beta1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "bun@1.3.13"
}
