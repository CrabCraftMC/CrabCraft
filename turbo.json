{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "jars/**",
        "spigot/build/libs/**",
        "velocity/build/libs/**"
      ],
      "env": ["DATABASE_URL", "NODE_ENV", "NEXT_PUBLIC_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:push": { "cache": false }
  },
  "globalEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET"
  ],
  "globalPassThroughEnv": [
    "TOKEN",
    "ENV",
    "DEV_GUILD_ID",
    "MEMBER_ROLE_ID",
    "MOD_ROLE_ID",
    "APPLICATION_CHANNEL_ID",
    "LOG_CHANNEL_ID",
    "LEADERBOARD_CHANNEL_ID",
    "WIKI_CHANNEL_ID",
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASS",
    "DB_NAME",
    "SITE_URL",
    "GIT_COMMIT_SHA"
  ]
}
